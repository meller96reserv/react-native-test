{
  "expo": {
    "name": "Skate Escape",
    "slug": "focus-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "focusflow",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100718",
    "plugins": ["expo-router", "expo-audio", "expo-font"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.focusflow"
    },
    "android": {
      "package": "com.example.focusflow",
      "predictiveBackGestureEnabled": false
    }
  }
}
